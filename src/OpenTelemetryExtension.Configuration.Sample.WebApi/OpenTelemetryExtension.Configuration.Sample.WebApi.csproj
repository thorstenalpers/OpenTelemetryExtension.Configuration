<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\WpfApp</DockerfileContext>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
    <Version>1.1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
	  <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.11.0" />
	  <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.2" />
	  <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
	  <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
	  <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
	  <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
	  <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
	  <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.1" />
	  <!-- Overrides the vulnerable transitive version pulled in by Microsoft.Data.SqlClient -->
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	  <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenTelemetryExtension.Configuration\OpenTelemetryExtension.Configuration.csproj" />
  </ItemGroup>

</Project>
